{
  "name": "network-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Network Academy – interaktive FISI-Lernsoftware (Netzwerktechnik, AP1)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"node server/index.mjs --dev\" \"vite\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "lucide-react": "^1.68.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
